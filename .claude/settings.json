{
  "permissions": {
    "allow": [
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label list*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git ls-tree*)",
      "Bash(git show*)",
      "Bash(git pull --rebase*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git rebase origin/main*)",
      "Bash(git push -u origin HEAD*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm build*)",
      "Bash(pnpm content:check*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm start*)"
    ],
    "deny": [
      "Bash(git push origin)",
      "Bash(git push)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
